{
  "name": "@react-viz-composer/components",
  "version": "0.1.0",
  "description": "Chart building blocks for ReactVizComposer — ChartFrame, Axis, scales, palette, and entry animation helpers",
  "license": "MIT",
  "author": "tycho",
  "repository": {
    "type": "git",
    "url": "https://github.com/1815304465/react-viz-composer"
  },
  "homepage": "https://github.com/1815304465/react-viz-composer#readme",
  "bugs": {
    "url": "https://github.com/1815304465/react-viz-composer/issues"
  },
  "keywords": [
    "react",
    "visualization",
    "chart",
    "svg",
    "canvas",
    "dataviz",
    "charts",
    "chart-components"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@react-viz-composer/core": "*"
  },
  "devDependencies": {
    "@react-viz-composer/core": "*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "@vitejs/plugin-react": "^6.0.3"
  }
}
