{
  "name": "react-viz-composer",
  "version": "0.1.0",
  "description": "Declarative SVG/Canvas hybrid rendering engine. Compose visualizations from Rect, Ellipse, Line, Path, Text, Image, Group, Animation primitives — with 48 built-in chart types.",
  "license": "MIT",
  "author": "tycho",
  "repository": {
    "type": "git",
    "url": "https://github.com/1815304465/react-viz-composer"
  },
  "homepage": "https://github.com/1815304465/react-viz-composer#readme",
  "bugs": {
    "url": "https://github.com/1815304465/react-viz-composer/issues"
  },
  "keywords": [
    "react",
    "visualization",
    "chart",
    "svg",
    "canvas",
    "declarative",
    "renderer",
    "2d",
    "dataviz",
    "charts",
    "graph"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./charts": {
      "import": "./dist/charts/index.js",
      "require": "./dist/charts/index.cjs",
      "types": "./dist/charts/index.d.ts"
    },
    "./charts/shared/mockData": {
      "import": "./dist/charts/shared/mockData.js",
      "require": "./dist/charts/shared/mockData.cjs",
      "types": "./dist/charts/shared/mockData.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "@vitejs/plugin-react": "^6.0.3"
  }
}
