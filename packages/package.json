{
  "name": "react-viz-composer",
  "version": "0.1.0",
  "description": "Declarative SVG/Canvas hybrid rendering engine. Compose visualizations from Rect, Ellipse, Line, Path, Text, Image, Group, Animation primitives, plus Axis/Grid/Tooltip helpers.",
  "license": "MIT",
  "author": "tycho",
  "repository": {
    "type": "git",
    "url": "https://github.com/1815304465/react-viz-composer",
    "directory": "packages"
  },
  "homepage": "https://github.com/1815304465/react-viz-composer#readme",
  "bugs": {
    "url": "https://github.com/1815304465/react-viz-composer/issues"
  },
  "keywords": [
    "react",
    "visualization",
    "chart",
    "svg",
    "canvas",
    "declarative",
    "renderer",
    "2d",
    "dataviz",
    "graph"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "@vitejs/plugin-react": "^6.0.3"
  }
}
