{
  "name": "@react-viz-composer/utilities",
  "version": "0.1.0",
  "description": "Zero-dependency pure utility functions for ReactVizComposer — scales, palette, easings, and math helpers",
  "license": "MIT",
  "author": "tycho",
  "repository": {
    "type": "git",
    "url": "https://github.com/1815304465/react-viz-composer"
  },
  "homepage": "https://github.com/1815304465/react-viz-composer#readme",
  "bugs": {
    "url": "https://github.com/1815304465/react-viz-composer/issues"
  },
  "keywords": [
    "visualization",
    "chart",
    "scale",
    "palette",
    "easing",
    "dataviz",
    "utilities"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
